{
 "lines": {
  "hook": {
   "start": 0.25,
   "end": 4.858,
   "text": "Stop scrolling. Fourteen tabs. Three terminals. Two agents... fighting over one branch.",
   "heard": "Stop scrolling, 14 tabs, three terminals, two agents, fighting over one branch"
  },
  "promise": {
   "start": 5.078,
   "end": 9.643,
   "text": "Give me ninety seconds. I'll show you the app that ends this, and a build at the end you'll want to steal.",
   "heard": "Give me 90 seconds. I'll show you the app that ends this and a build at the end you'll want to steal."
  },
  "reveal": {
   "start": 10.663,
   "end": 13.97,
   "text": "This is the GitHub Copilot app. Your agents finally have a home.",
   "heard": "This is the GitHub Copilot app. Your agents finally have a home."
  },
  "mywork": {
   "start": 14.19,
   "end": 21.294,
   "text": "One My Work view: every agent session, issue, pull request and automation, across all your repos. Mission control, for code.",
   "heard": "On My Work view, every agent session, issue, pull, request, and automation across all your repos. Mission control for code."
  },
  "worktree": {
   "start": 21.514,
   "end": 26.314,
   "text": "Every session gets its own git worktree. Five agents. Five lanes. Zero collisions.",
   "heard": "Every session gets its own Git worktree, 5 agents, 5 lanes, 0 collisions"
  },
  "merge": {
   "start": 26.534,
   "end": 36.625,
   "text": "Start from an issue. The agent writes the fix and opens the PR. Then Agent Merge babysits CI, fixes failing checks, and merges when your rules pass. You? Go touch grass.",
   "heard": "Start from an issue. The agent writes the fix and opens the PR, then Agent Merge Babysit CI, fixes failing checks and merges when your rules pass. You, go touch grass."
  },
  "models": {
   "start": 36.845,
   "end": 41.815,
   "text": "Pick a model and reasoning effort, or let Auto decide. Switch mid-task. Or bring your own key.",
   "heard": "Pick a model and reasoning effort or let auto -decide, switch mid -task or bring your own key."
  },
  "canvas": {
   "start": 42.035,
   "end": 50.398,
   "text": "Canvases are live surfaces you and the agent edit together. Plans, terminals, browsers, deployments. And Azure DevOps plugs straight into My Work.",
   "heard": "Canvases are live surfaces you and the Agent edit together. Plans, terminals, browsers, deployments, and Azure DevOps plugs straight into my work."
  },
  "safety": {
   "start": 50.618,
   "end": 56.079,
   "text": "Local or cloud sandbox. The cloud agent asks before every write, until you flip on autopilot.",
   "heard": "Local or Cloud Sandbox. The cloud agent asks before every write until you flip on autopilot."
  },
  "proof": {
   "start": 56.299,
   "end": 61.441,
   "text": "And the world is not waiting. GitHub says commits nearly doubled, to one point four billion a month.",
   "heard": "and the world is not waiting. GitHub says commits nearly doubled to $1 .4 billion a month."
  },
  "demo": {
   "start": 62.161,
   "end": 72.806,
   "text": "So here's the concept build. One weekend. Five agents. Phone capture, a Windows client, a streaming bridge, tests and docs, all in parallel. Boom. Your phone, live on your Windows desktop.",
   "heard": "So here's the concept build. One weekend, five agents. Phone capture, a Windows client, a streaming bridge, tests and docs all in parallel. Boom, your phone live on your Windows desktop."
  },
  "money": {
   "start": 73.026,
   "end": 80.749,
   "text": "The catch? It runs on AI credits, metered in tokens. But every plan includes monthly credits, and with a hard cap, your bill can't run away.",
   "heard": "The catch, it runs on AI credits, metered in tokens, but every plan includes monthly credits and with a hard cap, your bill can't run away."
  },
  "cta": {
   "start": 81.369,
   "end": 90.051,
   "text": "It's in technical preview right now, for Pro, Pro plus, Business and Enterprise. The devs who start today are already ahead. One app. Many agents. Ship it.",
   "heard": "It's in technical preview right now for Pro, Pro Plus, Business and Enterprise. The devs who start today are already ahead. One app, many agents, ship it."
  }
 },
