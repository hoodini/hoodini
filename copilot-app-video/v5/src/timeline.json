{
 "lines": {
  "open": {
   "start": 1.65,
   "end": 6.57,
   "text": "Eleven forty-seven p.m. Two hundred notifications. A release that ships tomorrow... and a promise.",
   "heard": "11 .47pm, 200 Notifications, a release that ships tomorrow and a promise."
  },
  "promise": {
   "start": 8.22,
   "end": 12.112,
   "text": "Six o'clock. Front row. Her daughter's very first piano recital.",
   "heard": "6 o 'clock, front row, her daughter's very first piano recital."
  },
  "habit": {
   "start": 13.362,
   "end": 18.12,
   "text": "Problem is, Dana does everything herself. Every branch. Every review. Every failing test.",
   "heard": "Problem is, Dana does everything herself, every ranch, every review, every failing test,"
  },
  "scale": {
   "start": 19.57,
   "end": 23.655,
   "text": "But more than a hundred and eighty million developers build on GitHub. And GitHub has seen this night before.",
   "heard": "but more than 180 million developers built on GitHub, and GitHub has seen this night before."
  },
  "reveal": {
   "start": 25.505,
   "end": 29.145,
   "text": "So they built the GitHub Copilot app. A desktop home for your coding agents.",
   "heard": "So they built the GitHub Copilot app, a desktop home for your coding agents."
  },
  "mywork": {
   "start": 29.895,
   "end": 34.694,
   "text": "Every session, issue and pull request, from every repo, in one calm place.",
   "heard": "Every session, issue and pull request from every repo in one calm place."
  },
  "handoff": {
   "start": 35.644,
   "end": 40.121,
   "text": "Dana hands one small bug to an agent. Just one. Very, very carefully.",
   "heard": "Dana hands one small bug to an agent, just one, very, very carefully."
  },
  "models": {
   "start": 40.871,
   "end": 43.412,
   "text": "She picks the model for the job... or lets Auto decide.",
   "heard": "She picks the model for the job or lets Auto decide."
  },
  "lanes": {
   "start": 44.162,
   "end": 47.733,
   "text": "Each agent gets its own git worktree, so nobody steps on anybody's toes.",
   "heard": "Each agent gets its own git worktree, so nobody steps on anybody's toes."
  },
  "merge": {
   "start": 48.533,
   "end": 53.808,
   "text": "Then Agent Merge watches the tests, keeps an eye on reviewers, fixes what breaks, and merges when her rules are met.",
   "heard": "Then Agent Merge watches the tests, keeps an eye on reviewers, fixes what breaks, and merges when her rules are met."
  },
  "sandbox": {
   "start": 54.608,
   "end": 58.128,
   "text": "Every agent works in a sandbox, on her laptop or in the cloud.",
   "heard": "Every agent works in a sandbox, on her laptop or in the cloud."
  },
  "control": {
   "start": 58.978,
   "end": 62.795,
   "text": "In the cloud, it asks before every change. And autopilot? That's her call.",
   "heard": "In the cloud it asks before every change, and autopilot, that's her call."
  },
  "ships": {
   "start": 63.795,
   "end": 67.818,
   "text": "And the team behind it ships fast. Eight new features in the first nineteen days.",
   "heard": "and the team behind it ships fast. Eight new features in the first 19 days."
  },
  "listen": {
   "start": 68.568,
   "end": 71.804,
   "text": "And developers can join the discussion, right in GitHub Community.",
   "heard": "and developers can join the discussion right in GitHub Community."
  },
  "payoff": {
   "start": 74.654,
   "end": 78.365,
   "text": "Six oh two, p.m. Front row. And the release? Merged... at four.",
   "heard": "6 .02 PM, front row, and the release merged at 4."
  },
  "cta": {
   "start": 80.215,
   "end": 83.743,
   "text": "The GitHub Copilot app. Let your agents do the work. Keep your evenings.",
   "heard": "the GitHub Copilot app. Let your agents do the work. Keep your evenings."
  }
 },
