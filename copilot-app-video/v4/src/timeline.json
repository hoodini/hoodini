{
 "lines": {
  "open": {
   "start": 0.9,
   "end": 6.78,
   "text": "Eleven forty-seven p.m. Dana has two hundred and twelve notifications, a release that ships tomorrow... and a promise.",
   "heard": "11 .47pm. Dana has 212 notifications, a release that ships tomorrow and a promise."
  },
  "promise": {
   "start": 7.43,
   "end": 10.59,
   "text": "Six o'clock. Front row. Her daughter's very first piano recital.",
   "heard": "6 o 'clock, front row, her daughter's very first piano recital."
  },
  "habit": {
   "start": 11.19,
   "end": 17.95,
   "text": "Thing is, Dana does everything herself. Every branch. Every review. Every failing test. Because the one time she didn't... yeah. We don't talk about that time.",
   "heard": "Thing is, Dana does everything herself. Every branch, every review, every failing test. Because the one time she didn't? Yeah, we don't talk about that time."
  },
  "scale": {
   "start": 18.65,
   "end": 25.45,
   "text": "But Dana's not alone. More than a hundred and eighty million developers build on GitHub. So GitHub has seen this night before. Many, many times.",
   "heard": "But Dana's not alone. More than 180 million developers build on GitHub, so GitHub has seen this night before, many, many times."
  },
  "reveal": {
   "start": 26.35,
   "end": 30.23,
   "text": "That's why they built the GitHub Copilot app. A desktop home for your coding agents.",
   "heard": "That's why they built the GitHub Copilot app, a desktop home for your coding agents."
  },
  "mywork": {
   "start": 30.53,
   "end": 37.29,
   "text": "All that noise lands in one calm place: My Work. Agent sessions, issues, pull requests and automations, from every repo.",
   "heard": "All that noise lands in one calm place, my work. Agent sessions, issues, pull requests and automations from every repo"
  },
  "handoff": {
   "start": 37.89,
   "end": 43.09,
   "text": "So Dana tries something new. She hands one small bug to an agent. Just one. Very, very carefully.",
   "heard": "So Dana tries something new. She hands one small bug to an agent. Just one. Very, very carefully."
  },
  "lanes": {
   "start": 43.39,
   "end": 49.91,
   "text": "Each agent works in its own copy of the code, a git worktree, so they never step on each other's toes. Or on hers.",
   "heard": "Each agent works in its own copy of the code, a git worktree, so they never step on each other's toes, or on hers."
  },
  "merge": {
   "start": 50.21,
   "end": 57.33,
   "text": "Then Agent Merge takes the part nobody enjoys. It watches the tests, keeps an eye on reviewers, fixes what breaks, and only merges when her rules are met.",
   "heard": "Then Agent Merge takes the part nobody enjoys. It watches the tests, keeps an eye on reviewers, fixes what breaks, and only merges when her rules are met."
  },
  "control": {
   "start": 57.83,
   "end": 66.63,
   "text": "And letting go doesn't mean losing control. Agents run in a sandbox. In the cloud, they ask before every change, and autopilot only switches on when you say so.",
   "heard": "And letting go doesn't mean losing control. Agents run in a sandbox. In the cloud, they ask before every change, and autopilot only switches on when you say so."
  },
  "money": {
   "start": 67.23,
   "end": 73.83,
   "text": "The honest part? It runs on AI credits. Every plan comes with a monthly amount, and you can set a hard cap, so the bill never surprises you.",
   "heard": "The honest part? It runs on AI credits. Every plan comes with a monthly amount, and you can set a hard cap so the bill never surprises you."
  },
  "listen": {
   "start": 74.43,
   "end": 81.55,
   "text": "And the team keeps shipping. Nineteen days after launch, eight new features landed, with an open feedback thread in GitHub Community.",
   "heard": "and the team keeps shipping. Nineteen days after launch, eight new features landed with an open feedback thread in GitHub Community."
  },
  "payoff": {
   "start": 82.85,
   "end": 86.85,
   "text": "Six oh two, p.m. Front row. And the release? Merged... at four.",
   "heard": "6 .02 PM, front row, and the release merged at 4."
  },
  "cta": {
   "start": 87.75,
   "end": 95.43,
   "text": "The GitHub Copilot app. In technical preview now, for Pro, Pro plus, Business and Enterprise. Let your agents do the work. Keep your evenings.",
   "heard": "The GitHub Copilot app. In technical preview now for Pro, ProPlus, Business, and Enterprise. Let your agents do the work. Keep your evenings."
  }
